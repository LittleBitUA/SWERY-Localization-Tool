---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "SWERY Localization Tool — Federal Bureau of Localization",
  description = "Open-source desktop editor that bundles the entire Ukrainian-localization workflow for five Hidetaka Suehiro (SWERY) / White Owls titles: Deadly Premonition, Deadly Premonition 2, The Good Life, Hotel Barcelona, THE MISSING.",
} = Astro.props;
const site = String(Astro.site).replace(/\/$/, "");
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = `${site}${base}/`;
const ogImage = `${site}${base}/og.png`;
const ogDesc = "One desktop app instead of five — text, fonts, textures, per-string box sizes — for the entire SWERY catalog.";
---
<!doctype html>
<html lang="uk">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#0a0806" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="SWERY, Hidetaka Suehiro, White Owls, Deadly Premonition, Deadly Premonition 2, The Good Life, Hotel Barcelona, THE MISSING, localization, Ukrainian, translation tool, modding, Electron, open source" />
  <meta name="author" content="Dmytro Bidlov" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={url} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="SWERY Localization Tool" />
  <meta property="og:title" content="SWERY Localization Tool — Federal Bureau of Localization" />
  <meta property="og:description" content={ogDesc} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:secure_url" content={ogImage} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="SWERY Localization Tool — Federal Bureau of Localization" />
  <meta property="og:locale" content="uk_UA" />
  <meta property="og:locale:alternate" content="en_US" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="SWERY Localization Tool" />
  <meta name="twitter:description" content={ogDesc} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content="SWERY Localization Tool — Federal Bureau of Localization" />

  <link rel="icon" href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='%230a0806'/><text x='50' y='70' font-family='Constantia,Georgia,serif' font-size='62' font-weight='700' font-style='italic' fill='%23d8c89a' text-anchor='middle'>S</text></svg>" />

  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "SWERY Localization Tool",
    "alternateName": "Federal Bureau of Localization",
    "description": description,
    "url": url,
    "image": ogImage,
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Windows",
    "author": {
      "@type": "Person",
      "name": "Dmytro Bidlov",
      "url": "https://steamcommunity.com/id/bidlochuk/"
    },
    "license": "https://opensource.org/licenses/MIT",
    "softwareVersion": "1.0.1",
    "downloadUrl": "https://github.com/LittleBitUA/SWERY-Localization-Tool/releases/latest",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  })} />
</head>
<body>
  <div class="bg-stage" aria-hidden="true"></div>
  <div class="layer">
    <slot />
  </div>

  <button id="scroll-top" class="scroll-top" type="button" aria-label="Наверх">
    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
    </svg>
  </button>

  <script is:inline>
    // i18n: ставимо <html lang> з localStorage перед усім rendering — щоб
    // не блимало EN-текстом на старті якщо у користувача збережений UK.
    (function () {
      try {
        const saved = localStorage.getItem("swery-site-lang");
        const lang = saved === "en" ? "en" : "uk";
        document.documentElement.lang = lang;
        // Підсвітити активну кнопку відразу
        document.querySelectorAll("[data-lang-btn]").forEach((b) => {
          b.classList.toggle("active", b.dataset.langBtn === lang);
        });
      } catch {}
    })();
    document.querySelectorAll("[data-lang-btn]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const lang = btn.dataset.langBtn;
        document.documentElement.lang = lang;
        try { localStorage.setItem("swery-site-lang", lang); } catch {}
        document.querySelectorAll("[data-lang-btn]").forEach((b) => {
          b.classList.toggle("active", b.dataset.langBtn === lang);
        });
      });
    });

    // Reveal-on-scroll
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add("in");
          io.unobserve(e.target);
        }
      }
    }, { threshold: 0.12 });
    document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

    // Workshop tabs
    document.querySelectorAll(".workshop-tab").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.dataset.tab;
        document.querySelectorAll(".workshop-tab").forEach((b) => b.classList.toggle("active", b === btn));
        document.querySelectorAll(".workshop-panel").forEach((p) => p.classList.toggle("active", p.id === id));
      });
    });

    // Scroll-to-top button: показується після ~400px прокрутки.
    const scrollBtn = document.getElementById("scroll-top");
    if (scrollBtn) {
      const onScroll = () => {
        scrollBtn.classList.toggle("visible", window.scrollY > 400);
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
      scrollBtn.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    }
  </script>
</body>
</html>
