---
const version = "1.1.2";
const downloadHref = "https://github.com/LittleBitUA/SWERY-Localization-Tool/releases/latest";
const issuesHref = "https://github.com/LittleBitUA/SWERY-Localization-Tool/issues/new";
---
<div class="asterism">✦  ✦  ✦</div>

<section class="final-cta">
  <div class="section-inner">
    <div class="section-tag">Get the toolkit</div>
    <h2 class="section-title">Ready to investigate?</h2>
    <p class="section-lede" style="margin-left: auto; margin-right: auto; text-align: center;">
      Portable <code>.exe</code>, ~87 MB. Без інсталяції. На головному екрані —
      обирай гру, вказуй Steam-папку, починай перекладати.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={downloadHref}>Download v{version}</a>
      <a class="btn" href={issuesHref}>Report an issue</a>
    </div>
  </div>
</section>
