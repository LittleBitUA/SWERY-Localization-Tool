---
import L from "./L.astro";
const downloadHref = "https://github.com/LittleBitUA/SWERY-Localization-Tool/releases/latest";
const repoHref = "https://github.com/LittleBitUA/SWERY-Localization-Tool";
---
<header class="hero">
  <div class="bureau-mark">Federal Bureau of Localization</div>
  <h1 class="hub-title">SWERY Localization Tool</h1>
  <div class="hub-subtitle">Investigation log · case files · build manuals</div>

  <p class="hub-lede">
    <L
      uk="Один настільний інструмент, який обʼєднує перекладацький pipeline для п'яти ігор Hidetaka Suehiro (SWERY) та White Owls — від редагування JSON-дампів до запаковки фінального патчу, з вбудованими редакторами шрифтів, текстур і per-string box-sizes."
      en="One open-source desktop tool that bundles the entire translation workflow for five Hidetaka Suehiro (SWERY) / White Owls titles — from editing JSON dumps to packing the final patch, with built-in font, texture and per-string box-size editors."
    />
  </p>

  <div class="hero-actions">
    <a class="btn btn-primary" href={downloadHref}>
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5 5-5M12 15V3"/>
      </svg>
      <L uk="Завантажити portable" en="Download portable" />
    </a>
    <a class="btn" href={repoHref}>
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 0C5.4 0 0 5.4 0 12c0 5.3 3.4 9.8 8.2 11.4.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.6-4-1.6-.5-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2 1-.3 2-.4 3-.4s2 .1 3 .4c2.3-1.5 3.3-1.2 3.3-1.2.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6C20.6 21.8 24 17.3 24 12 24 5.4 18.6 0 12 0z"/>
      </svg>
      <L uk="Дивитись на GitHub" en="View source on GitHub" />
    </a>
  </div>

  <p class="case-marker">
    <L uk="Investigation period:" en="Investigation period:" /> <b>2026 — current</b> ·
    <L uk="License:" en="License:" /> <b>MIT</b> ·
    <L uk="Platform:" en="Platform:" /> <b>Windows portable</b>
  </p>
</header>
